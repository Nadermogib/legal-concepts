WORKDAY_END=16:00
ATTENDANCE_WINDOW_END=12:00
PUNCH_WINDOW_START=06:00
PUNCH_WINDOW_END=17:00

# الدوائر المفعّلة افتراضياً للبذر الأولي (اختياري - مفصولة بفواصل)
DEFAULT_ENABLED_DEPARTMENT_IDS=98210,98211,98212,175765

# المصادقة الأساسية للوحة التحكم (اختياري - تفعيل عند وجود القيمتين)
DASHBOARD_USER=
DASHBOARD_PASS=
